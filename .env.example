# Copy to .env and fill in. .env is ignored by git: it holds the site's location.

# Where the stack keeps its data, outside the repository (design D2).
EM_DATA_DIR=

# The roof plane, as in the forecast.solar estimate URL (requirements 2.3).
# Latitude and longitude in degrees; declination (tilt) in degrees from horizontal;
# azimuth in degrees, 0 = south, -90 = east, 90 = west; installed peak power in kWp.
EM_LATITUDE=
EM_LONGITUDE=
EM_DECLINATION=
EM_AZIMUTH=
EM_KWP=

# The forecast archive's read-only endpoint, on this machine only (design D8).
EM_ARCHIVE_PORT=8765
