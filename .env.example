# Copy to .env and fill in. .env is ignored by git: it holds the site's location.

# Where the stack keeps its data, outside the repository (design D2).
EM_DATA_DIR=

# The Zigbee coordinator's USB serial device, by its stable name:
# ls /dev/serial/by-id/ (e.g. /dev/serial/by-id/usb-Nabu_Casa_ZBT-2_<serial>-if00).
EM_ZIGBEE_DEVICE=

# The roof plane, as in the forecast.solar estimate URL (requirements 2.3).
# Latitude and longitude in degrees; declination (tilt) in degrees from horizontal;
# azimuth in degrees, 0 = south, -90 = east, 90 = west; installed peak power in kWp.
EM_LATITUDE=
EM_LONGITUDE=
EM_DECLINATION=
EM_AZIMUTH=
EM_KWP=

# The forecast archive's read-only endpoint, on this machine only (design D8).
EM_ARCHIVE_PORT=8765
# Electricity prices for the weekly net cost (E20): the grid import price and the
# feed-in tariff, in € per kWh.
EM_GRID_PRICE_EUR_PER_KWH=0.30
EM_FEED_IN_PRICE_EUR_PER_KWH=0.08

# The collector (change collect-device-details): the inverter's address on the
# home network and its port, and the collector's endpoint, on this machine only.
EM_RCT_HOST=
EM_RCT_PORT=8899
EM_COLLECTOR_PORT=8766
# Home Assistant's API for the collector, and a long-lived token (profile →
# Security). With HTTPS on the home network: https://localhost:8123 and
# EM_HA_CAFILE=/tls/ca.crt.
EM_HA_URL=http://localhost:8123
EM_HA_CAFILE=
HA_TOKEN=
